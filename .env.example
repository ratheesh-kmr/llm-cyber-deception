# ============================================================
# Active Cyber Deception with LLM-Generated Lures
# Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in the appropriate values
#   3. NEVER commit .env to source control
#   4. Do NOT add real API keys or credentials here
# ============================================================

# ── Application ───────────────────────────────────────────
APP_NAME="Active Cyber Deception Platform"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── Database ──────────────────────────────────────────────
# SQLite (default for development):
DATABASE_URL=sqlite:///./deception.db

# PostgreSQL (for production, uncomment and fill):
# DATABASE_URL=postgresql://user:password@localhost:5432/deception_db

# ── LLM Provider ─────────────────────────────────────────
# Options: mock | ollama | openai
# Use 'mock' for demo mode (no external LLM required)
LLM_PROVIDER=mock

# Ollama configuration (local LLM, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI-compatible API configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM generation settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_FALLBACK_TO_MOCK=true

# ── Risk Scoring Configuration ───────────────────────────
# Risk score thresholds
RISK_LOW_THRESHOLD=3
RISK_MEDIUM_THRESHOLD=7
RISK_HIGH_THRESHOLD=11

# Risk score increments (configurable)
RISK_ADMIN_ACCESS=2
RISK_CONFIG_ACCESS=3
RISK_BACKUP_ACCESS=3
RISK_FAILED_REQUESTS=2
RISK_CREDENTIAL_ATTEMPT=4
RISK_RAPID_REQUESTS=3
RISK_DIRECTORY_TRAVERSAL=4

# Lure generation trigger threshold
LURE_GENERATION_RISK_THRESHOLD=4

# ── Dashboard Authentication ──────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# ── CORS / Security ───────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SIMULATION_PER_HOUR=10

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/deception.log

# ── Deception Environment ────────────────────────────────
FAKE_COMPANY_NAME="Meridian Technologies Ltd."
FAKE_DOMAIN=meridian-tech.internal
DECEPTION_ENV_HOST=0.0.0.0
DECEPTION_ENV_PORT=8001

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="Cyber Deception Platform"
